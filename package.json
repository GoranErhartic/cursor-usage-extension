{
  "name": "cursor-usage",
  "displayName": "Cursor Usage",
  "description": "Shows Cursor plan usage in the status bar",
  "version": "1.0.0",
  "icon": "images/icon.png",
  "publisher": "goranerhartic",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/GoranErhartic/cursor-usage-extension.git"
  },
  "homepage": "https://lazydev.ai/#cursor-usage",
  "bugs": {
    "url": "https://github.com/GoranErhartic/cursor-usage-extension/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursorUsage.refresh",
        "title": "Cursor Usage: Refresh"
      },
      {
        "command": "cursorUsage.signIn",
        "title": "Cursor Usage: Sign In"
      },
      {
        "command": "cursorUsage.signOut",
        "title": "Cursor Usage: Sign Out"
      }
    ],
    "configuration": {
      "title": "Cursor Usage",
      "properties": {
        "cursorUsage.pollIntervalMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "How often to poll the usage API (minutes)."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "package": "npx --yes @vscode/vsce@3.9.2 package --no-dependencies",
    "vscode:prepublish": "pnpm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}
